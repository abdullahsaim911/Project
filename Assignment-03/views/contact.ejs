<!DOCTYPE html>
<html lang="en-US">

<head>
    <%- include('partials/head') %>
</head>

<body>

    <%- include('partials/navbar', { page: 'contact' }) %>

        <main>
            <section class="contact-intro"
                style="padding: 100px 0 60px; text-align: center; background-color: #fcfcfc;">
                <div class="container">
                    <h1>Contact Us</h1>
                    <p>Get in touch with us for your next project.</p>
                    <div class="separator">
                        <img src="/assets/home_handyman_sep.png" alt="Separator">
                    </div>
                </div>
            </section>

            <section class="contact-form-section" style="padding: 60px 0;">
                <div class="container" style="max-width: 800px; margin: 0 auto;">
                    <form action="#" method="POST" class="contact-form">
                        <div style="margin-bottom: 20px;">
                            <label for="name" style="display: block; margin-bottom: 5px;">Name</label>
                            <input type="text" id="name" name="name"
                                style="width: 100%; padding: 10px; border: 1px solid #ddd;" required>
                        </div>
                        <div style="margin-bottom: 20px;">
                            <label for="email" style="display: block; margin-bottom: 5px;">Email</label>
                            <input type="email" id="email" name="email"
                                style="width: 100%; padding: 10px; border: 1px solid #ddd;" required>
                        </div>
                        <div style="margin-bottom: 20px;">
                            <label for="message" style="display: block; margin-bottom: 5px;">Message</label>
                            <textarea id="message" name="message" rows="5"
                                style="width: 100%; padding: 10px; border: 1px solid #ddd;" required></textarea>
                        </div>
                        <button type="submit" class="cta-button" style="border: none; cursor: pointer;">Send
                            Message</button>
                    </form>
                </div>
            </section>

            <section class="secondary-cta">
                <div class="container">
                    <h2>+61 (0) 7 9180 3458</h2>
                    <p>Call us for free visit and pricing</p>
                </div>
            </section>
        </main>

        <%- include('partials/footer') %>

</body>

</html>
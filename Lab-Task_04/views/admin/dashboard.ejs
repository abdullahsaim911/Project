<%- include('partials/header') %>

    <div class="admin-header">
        <h1>Dashboard</h1>
        <a href="/admin/add-product" class="btn btn-primary">Add New Product</a>
    </div>

    <% if (products.length> 0) { %>
        <table class="table">
            <thead>
                <tr>
                    <th>Image</th>
                    <th>Name</th>
                    <th>Price</th>
                    <th>Category</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                <% products.forEach(product=> { %>
                    <tr>
                        <td>
                            <% if(product.image) { %>
                                <img src="<%= product.image %>" alt="<%= product.name %>" class="product-thumbnail">
                                <% } else { %>
                                    No Image
                                    <% } %>
                        </td>
                        <td>
                            <%= product.name %>
                        </td>
                        <td>Rp<%= product.price %>
                        </td>
                        <td>
                            <%= product.category %>
                        </td>
                        <td>
                            <a href="/admin/edit-product/<%= product._id %>" class="btn btn-warning">Edit</a>
                            <a href="/admin/delete-product/<%= product._id %>" class="btn btn-danger"
                                onclick="return confirm('Are you sure you want to delete this product?');">Delete</a>
                        </td>
                    </tr>
                    <% }) %>
            </tbody>
        </table>
        <% } else { %>
            <p>No products found.</p>
            <% } %>

                <%- include('partials/footer') %>